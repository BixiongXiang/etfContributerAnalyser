# ─────────────────────────────────────────────────────────────
# Market Attribution Dashboard — environment variables
# Copy this file to .env and edit as needed.
# All values have defaults; zero configuration required for dev.
# ─────────────────────────────────────────────────────────────

# Data provider: "yfinance" (free, default) or "fmp" (requires key below)
DATA_PROVIDER=yfinance

# Financial Modeling Prep API key
# Get a free key at https://financialmodelingprep.com/
# Only required when DATA_PROVIDER=fmp
FMP_API_KEY=

# SQLite database path (relative to backend/ directory)
DATABASE_URL=sqlite+aiosqlite:///./data/market_attribution.db

# Time to run daily update (24h HH:MM, US/Eastern)
SCHEDULE_TIME=16:15

# Retry times if primary update fails (comma-separated HH:MM)
SCHEDULE_RETRIES=16:30,17:00

# How many days of historical prices to backfill on first startup
BACKFILL_DAYS=30

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS: allowed origins (space-separated)
# Dev default allows the Next.js dev server.
CORS_ORIGINS=http://localhost:3000 http://frontend:3000
